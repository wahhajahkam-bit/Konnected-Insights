{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "buildCommand": "test -f src/app.ts && test ! -e src/index.ts"
    },
    "konnected-insights": {
      "root": "artifacts/konnected-insights",
      "framework": "vite",
      "buildCommand": "BASE_PATH=/ PORT=5173 pnpm run build",
      "outputDirectory": "dist/public",
      "routes": [
        { "handle": "filesystem" },
        { "src": "^/[^.]*$", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api-server" } },
    { "source": "/(.*)", "destination": { "service": "konnected-insights" } }
  ]
}
