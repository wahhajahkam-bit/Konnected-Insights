{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:serve": "esbuild src/test-server.ts --bundle --platform=node --format=cjs --external:pino --outfile=tmp/editorial-test-server.cjs && node tmp/editorial-test-server.cjs",
    "test:insights-chat": "esbuild src/lib/insightsChat.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/insights-chat.test.cjs && node --test /tmp/insights-chat.test.cjs",
    "test:future-work-presentation": "esbuild src/lib/futureWorkPresentation.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/future-work-presentation.test.cjs && NODE_ENV=production node --test /tmp/future-work-presentation.test.cjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "future-work:run-due": "node --enable-source-maps ./dist/future-work-runner.mjs",
    "test:future-work": "esbuild src/lib/futureWork.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/future-work.test.cjs && esbuild src/lib/futureWorkGrounding.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/future-work-grounding.test.cjs && esbuild src/lib/futureWorkHistory.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/future-work-history.test.cjs && node --test /tmp/future-work.test.cjs /tmp/future-work-grounding.test.cjs /tmp/future-work-history.test.cjs",
    "newsletter-sources:run-due": "pnpm run build && node --enable-source-maps ./dist/runDueNewsletterSources.mjs",
    "test:security": "esbuild src/lib/editorialInvitationClaim.test.ts src/lib/editorialUrlSafety.test.ts src/lib/editorialContributor.test.ts src/lib/editorialGeneration.test.ts src/lib/editorialWriteValidation.test.ts src/lib/linkedinNewsletterIngestion.test.ts src/lib/gmailNewsletterIngestion.test.ts src/routes/editorial-seed.test.ts --bundle --platform=node --format=esm --outdir=/tmp/editorial-security-tests && node --test /tmp/editorial-security-tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:newsletter-integration": "esbuild src/lib/gmailNewsletterScheduler.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/gmail-newsletter-integration.test.cjs && NODE_ENV=production node --test /tmp/gmail-newsletter-integration.test.cjs",
    "test:future-work-preflight-integration": "esbuild src/routes/future-work-preflight.integration.test.ts --bundle --platform=node --format=cjs --external:pino --outfile=tmp/future-work-preflight.integration.test.cjs && node --test tmp/future-work-preflight.integration.test.cjs",
    "test:future-work-history-integration": "esbuild src/lib/futureWorkHistory.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/future-work-history.integration.test.cjs && node --test /tmp/future-work-history.integration.test.cjs",
    "test:automation": "esbuild src/lib/editorialAutomation.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/editorial-automation-tests.test.cjs && node --test /tmp/editorial-automation-tests.test.cjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@clerk/shared": "^4.30.1",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
